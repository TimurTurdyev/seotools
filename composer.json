{
    "name": "timur-turdyev/seotools",
    "description": "Framework-agnostic SEO head markup builder: meta, Open Graph, Twitter/X Cards and JSON-LD, with a lazy Laravel integration layer.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Timur Turdyev",
            "email": "mercurioplatform@gmail.com"
        }
    ],
    "keywords": [
        "seo",
        "meta",
        "open-graph",
        "twitter-cards",
        "json-ld",
        "schema-org",
        "laravel"
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "illuminate/support": "Required to use the Laravel integration layer (service provider, facade, Blade output)."
    },
    "autoload": {
        "psr-4": {
            "TimurTurdyev\\Seotools\\": "src/"
        },
        "files": [
            "src/Laravel/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "TimurTurdyev\\Seotools\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "TimurTurdyev\\Seotools\\Laravel\\SeotoolsServiceProvider"
            ],
            "aliases": {
                "Seo": "TimurTurdyev\\Seotools\\Laravel\\Facades\\Seo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
